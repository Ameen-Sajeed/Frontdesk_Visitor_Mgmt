generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VisitType {
  APPOINTMENT
  WALK_IN
}

enum VisitStatus {
  WAITING
  INSIDE
  CHECKED_OUT
  LEFT_WITHOUT_MEETING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  RECEPTIONIST
  DEPARTMENT_LEAD
}

enum UserAccountStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum VisitForwardStatus {
  PENDING
  COMPLETED
}

model User {
  id           String      @id @default(cuid())
  employeeId   String      @unique
  name         String
  email        String      @unique
  password     String
  role         Role        @default(RECEPTIONIST)
  accountStatus UserAccountStatus @default(PENDING)
  designation  String?
  availabilityStatus String @default("ACTIVE")
  customStatus String?
  customStatusEmoji String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  customStatusHistory UserCustomStatus[]
  sessions     UserSession[]
  visitStatusChanges VisitStatusHistory[] @relation("VisitStatusChangedBy")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model UserCustomStatus {
  id        String   @id @default(cuid())
  userId    String
  emoji     String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, emoji, text])
  @@index([userId, updatedAt])
}

model UserSession {
  id              String    @id @default(cuid())
  userId          String
  loginAt         DateTime  @default(now())
  logoutAt        DateTime?
  durationSeconds Int?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]
  users     User[]
  visits    Visit[]
  meetings  VisitMeeting[]
}

model Employee {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  designation  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  visits       Visit[]    @relation("VisitHost")
  meetings     VisitMeeting[] @relation("MeetingHost")
  createdAt    DateTime   @default(now())
}

model Visitor {
  id             String   @id @default(cuid())
  fullName       String
  phone          String
  phoneLookupKey String   @default("")
  email          String?
  company        String?
  designation    String?
  createdAt      DateTime @default(now())
  visits         Visit[]

  @@unique([phoneLookupKey])
}

model Visit {
  id                String      @id @default(cuid())
  visitorId         String
  departmentId      String
  hostId            String
  purpose           String
  type              VisitType
  status            VisitStatus @default(WAITING)
  approvalStatus    ApprovalStatus @default(PENDING)
  priority          Int         @default(0)
  rejectionReason   String?
  leftReason        String?
  leftAt            DateTime?
  delayedNotifiedAt DateTime?
  registeredAt      DateTime    @default(now())
  approvalAskedAt   DateTime?
  decidedAt         DateTime?
  checkedInAt       DateTime?
  meetingStartedAt  DateTime?
  checkedOutAt      DateTime?
  visitor           Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  department        Department  @relation(fields: [departmentId], references: [id])
  host              Employee    @relation("VisitHost", fields: [hostId], references: [id])
  history           VisitStatusHistory[]
  forwardRequests   VisitForwardRequest[]
  meetings          VisitMeeting[]

  @@index([departmentId, status, priority, approvalAskedAt])
  @@index([status, registeredAt])
}

model VisitMeeting {
  id          String     @id @default(cuid())
  visitId     String
  departmentId String
  hostId      String
  startedAt   DateTime   @default(now())
  endedAt     DateTime?
  endedReason String?
  visit       Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  department  Department @relation(fields: [departmentId], references: [id])
  host        Employee   @relation("MeetingHost", fields: [hostId], references: [id])

  @@index([visitId, startedAt])
  @@index([hostId, endedAt])
}

model VisitForwardRequest {
  id               String             @id @default(cuid())
  visitId          String
  fromDepartmentId String
  toDepartmentId   String
  suggestedHostIds String[]           @default([])
  note             String?
  requestedByUserId String
  requestedAt      DateTime           @default(now())
  handledAt        DateTime?
  handledByUserId  String?
  status           VisitForwardStatus @default(PENDING)
  visit            Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@index([visitId, status])
}

model VisitStatusHistory {
  id        String      @id @default(cuid())
  visitId   String
  status    VisitStatus
  createdAt DateTime    @default(now())
  note      String?
  changedByUserId String?
  visit     Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  changedBy User?       @relation("VisitStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([visitId, createdAt])
  @@index([changedByUserId])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
