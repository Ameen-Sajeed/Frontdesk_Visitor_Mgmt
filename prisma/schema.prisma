generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VisitType {
  APPOINTMENT
  WALK_IN
}

enum VisitStatus {
  REGISTERED
  WAITING_APPROVAL
  APPROVED
  REJECTED
  CHECKED_IN
  IN_MEETING
  CHECKED_OUT
  LEFT_WITHOUT_MEETING
}

enum Role {
  RECEPTIONIST
  DEPARTMENT_LEAD
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  password     String
  role         Role        @default(RECEPTIONIST)
  designation  String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]
  users     User[]
  visits    Visit[]
}

model Employee {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  designation  String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  visits       Visit[]    @relation("VisitHost")
  createdAt    DateTime   @default(now())
}

model Visitor {
  id             String   @id @default(cuid())
  fullName       String
  phone          String
  phoneLookupKey String   @default("")
  email          String?
  company        String?
  designation    String?
  createdAt      DateTime @default(now())
  visits         Visit[]

  @@index([phoneLookupKey])
}

model Visit {
  id                String      @id @default(cuid())
  visitorId         String
  departmentId      String
  hostId            String
  purpose           String
  type              VisitType
  status            VisitStatus @default(REGISTERED)
  priority          Int         @default(0)
  rejectionReason   String?
  leftReason        String?
  leftAt            DateTime?
  delayedNotifiedAt DateTime?
  registeredAt      DateTime    @default(now())
  approvalAskedAt   DateTime?
  decidedAt         DateTime?
  checkedInAt       DateTime?
  meetingStartedAt  DateTime?
  checkedOutAt      DateTime?
  visitor           Visitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  department        Department  @relation(fields: [departmentId], references: [id])
  host              Employee    @relation("VisitHost", fields: [hostId], references: [id])
  history           VisitStatusHistory[]

  @@index([departmentId, status, priority, approvalAskedAt])
  @@index([status, registeredAt])
}

model VisitStatusHistory {
  id        String      @id @default(cuid())
  visitId   String
  status    VisitStatus
  createdAt DateTime    @default(now())
  note      String?
  visit     Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
}

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
